{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chapter-plan-output (v9)",
  "type": "object",
  "required": ["chapters"],
  "additionalProperties": false,
  "properties": {
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "start_page"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "start_page": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
