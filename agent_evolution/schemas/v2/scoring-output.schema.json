{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoring-output.schema.json",
  "title": "ScoringOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores"],
  "properties": {
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation_item_id",
          "evidence_score",
          "correctness_score",
          "difficulty_score",
          "learning_value_score"
        ],
        "properties": {
          "generation_item_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "correctness_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "difficulty_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "learning_value_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    }
  }
}
