{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generator-output.schema.json",
  "title": "GeneratorOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "question", "answer"],
            "properties": {
              "type": { "const": "QUESTION" },
              "question": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "statement", "answer_boolean", "explanation"],
            "properties": {
              "type": { "const": "TRUE_FALSE" },
              "statement": { "type": "string", "minLength": 1 },
              "answer_boolean": { "type": "boolean" },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
