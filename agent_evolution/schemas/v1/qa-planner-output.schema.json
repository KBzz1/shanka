{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qa-planner-output (v1)",
  "type": "object",
  "required": ["qa_pairs"],
  "additionalProperties": false,
  "properties": {
    "qa_pairs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_type", "question", "source_chunk_ids"],
            "properties": {
              "card_type": { "const": "QUESTION" },
              "question": { "type": "string", "minLength": 2, "maxLength": 500 },
              "source_chunk_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_type", "statement", "source_chunk_ids"],
            "properties": {
              "card_type": { "const": "TRUE_FALSE" },
              "statement": { "type": "string", "minLength": 2, "maxLength": 500 },
              "source_chunk_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "type": "string" }
              }
            }
          }
        ]
      }
    }
  }
}
