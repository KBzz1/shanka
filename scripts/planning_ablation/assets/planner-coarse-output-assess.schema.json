{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planner-coarse-output (density assessment variant draft)",
  "type": "object",
  "required": ["density_assessment", "topics"],
  "additionalProperties": false,
  "properties": {
    "density_assessment": {
      "enum": ["RICH", "NORMAL", "SPARSE"]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "coverage_tier", "source_chunk_ids"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "coverage_tier": {
            "enum": ["CORE", "IMPORTANT", "LOW_FREQUENCY"]
          },
          "source_chunk_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
